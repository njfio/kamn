# Capacity CI dry-run governance threshold fixture.

CAPACITY_CI_DRY_RUN_POLICY_SCHEMA_VERSION=kamn.ci.capacity-ci-dry-run-governance-report.v1
CAPACITY_CI_DRY_RUN_REASON_TAXONOMY_VERSION=kamn.ci.capacity-ci-dry-run-governance-reason-taxonomy.v1
CAPACITY_CI_DRY_RUN_REASON_CODES_CSV=capacity_ci_dry_run_argument_invalid,capacity_ci_dry_run_threshold_contract_violation,capacity_ci_dry_run_report_contract_violation,capacity_ci_dry_run_go_no_go_marker_parity_drift,capacity_ci_dry_run_performance_marker_parity_drift,capacity_ci_dry_run_runtime_budget_exceeded,capacity_ci_dry_run_fast_mode_selector_drift,capacity_ci_dry_run_workflow_exclusion_drift,capacity_ci_dry_run_docs_marker_parity_drift,capacity_ci_dry_run_docs_remediation_marker_missing
CAPACITY_CI_DRY_RUN_MAX_SECONDS=120

PERFORMANCE_SMOKE_EXPECTED_LANE=smoke
PERFORMANCE_SMOKE_EXPECTED_WORKLOAD=runtime
PERFORMANCE_SMOKE_REQUIRED_MARKERS_CSV=baseline_provenance_artifact_version,baseline_provenance_source_commit,baseline_provenance_source_run_id,baseline_provenance_generated_at_utc,baseline_provenance_generator,drift_threshold_seed_id,latency_p50_ms,latency_p99_ms,throughput_tps,availability_pct

GO_NO_GO_EXPECTED_SCHEMA_VERSION=kamn.runtime.go-no-go-gate-report.v1
GO_NO_GO_EXPECTED_REASON_TAXONOMY_VERSION=kamn.runtime.go-no-go-gate-reason-taxonomy.v1
GO_NO_GO_EXPECTED_STATUS=pass
GO_NO_GO_EXPECTED_FINAL_DECISION=GO
GO_NO_GO_EXPECTED_LANE_MODE=dry-run
GO_NO_GO_EXPECTED_FAST_GATE_ELIGIBLE=true
GO_NO_GO_EXPECTED_FAST_GATE_SCOPE=ci-fast-gate
GO_NO_GO_EXPECTED_FAST_GATE_EXCLUSION_REASON_CODE=go_no_go_gate_run_mode_excluded_from_fast_gate
GO_NO_GO_EXPECTED_RUN_MODE_COMMAND_STATUS=dry_run_no_commands_executed
GO_NO_GO_REQUIRED_PROMOTION_DECISION_REASON_MARKERS_CSV=release_manifest_missing_required_artifact,gate_required_artifact_status_mismatch,runtime_budget_exceeded
GO_NO_GO_REQUIRED_PROMOTION_EVIDENCE_REASON_MARKERS_CSV=promotion_evidence_link_missing,promotion_evidence_payload_tamper_detected,promotion_decision_reason_mapping_mismatch

CI_TOOLS_FAST_MODE_REQUIRED_ENTRY=cargo test -p kamn-core --test capacity_ci_dry_run_governance_contract -- --nocapture
CI_TOOLS_FAST_MODE_FORBIDDEN_ENTRY=bash "$ROOT_DIR/scripts/runtime/run_go_no_go_gate_lane.sh" --mode run
CI_FAST_GATE_WORKFLOW_FORBIDDEN_ENTRY=bash scripts/runtime/run_go_no_go_gate_lane.sh --mode run
