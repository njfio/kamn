# Daemon OS-signal stress matrix dry-run governance thresholds (Issue #4096)
REPORT_SCHEMA_VERSION=kamn.ci.daemon-os-signal-stress-matrix-report.v1
MAX_RUNTIME_SECONDS=600
ALLOWED_REASON_CODES_CSV=runtime_budget_exceeded,matrix_failure_threshold_exceeded,quarantine_registry_missing,quarantine_reference_present_without_followup,matrix_failures_within_threshold,stable_success_with_quarantine_followup,stable_success
CI_TOOLS_REQUIRED_ENTRY=test_run_daemon_os_signal_stress_matrix.sh
CI_TOOLS_FORBIDDEN_ENTRY=run_daemon_os_signal_stress_matrix.sh
