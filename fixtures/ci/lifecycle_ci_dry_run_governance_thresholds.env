# Lifecycle artifact CI dry-run governance threshold fixture.

LIFECYCLE_CI_DRY_RUN_POLICY_SCHEMA_VERSION=kamn.ci.lifecycle-ci-dry-run-governance-report.v1
LIFECYCLE_CI_DRY_RUN_REASON_TAXONOMY_VERSION=kamn.ci.lifecycle-ci-dry-run-governance-reason-taxonomy.v1
LIFECYCLE_CI_DRY_RUN_REASON_CODES_CSV=lifecycle_ci_dry_run_argument_invalid,lifecycle_ci_dry_run_threshold_contract_violation,lifecycle_ci_dry_run_report_contract_violation,lifecycle_ci_dry_run_lifecycle_marker_parity_drift,lifecycle_ci_dry_run_go_no_go_marker_parity_drift,lifecycle_ci_dry_run_runtime_budget_exceeded,lifecycle_ci_dry_run_fast_mode_selector_drift,lifecycle_ci_dry_run_workflow_exclusion_drift,lifecycle_ci_dry_run_docs_marker_parity_drift,lifecycle_ci_dry_run_docs_remediation_marker_missing
LIFECYCLE_CI_DRY_RUN_MAX_SECONDS=120

LIFECYCLE_ARTIFACT_EXPECTED_SCHEMA_VERSION=kamn.runtime.lifecycle-artifact-integrity-evidence.v1
LIFECYCLE_ARTIFACT_EXPECTED_ARTIFACT_SCHEMA_VERSION=kamn.runtime.lifecycle-artifact-integrity-schema.v1
LIFECYCLE_ARTIFACT_EXPECTED_REASON_TAXONOMY_VERSION=kamn.runtime.lifecycle-artifact-integrity-reason-taxonomy.v1
LIFECYCLE_ARTIFACT_EXPECTED_REASON_CODES_CSV=lifecycle_artifact_required_field_missing,lifecycle_artifact_marker_mismatch,lifecycle_artifact_hash_mismatch,lifecycle_artifact_reason_taxonomy_mismatch,lifecycle_artifact_reason_codes_csv_mismatch,lifecycle_artifact_expected_decision_mismatch
LIFECYCLE_ARTIFACT_EXPECTED_FINAL_DECISION=GO
LIFECYCLE_ARTIFACT_REQUIRED_HASH_FIELDS_CSV=payload_hash_sha256,integrity_hash_sha256,provenance_hash_sha256

GO_NO_GO_EXPECTED_SCHEMA_VERSION=kamn.runtime.go-no-go-gate-report.v1
GO_NO_GO_EXPECTED_REASON_TAXONOMY_VERSION=kamn.runtime.go-no-go-gate-reason-taxonomy.v1
GO_NO_GO_EXPECTED_STATUS=pass
GO_NO_GO_EXPECTED_FINAL_DECISION=GO
GO_NO_GO_EXPECTED_LANE_MODE=dry-run
GO_NO_GO_EXPECTED_FAST_GATE_ELIGIBLE=true
GO_NO_GO_EXPECTED_FAST_GATE_SCOPE=ci-fast-gate
GO_NO_GO_EXPECTED_FAST_GATE_EXCLUSION_REASON_CODE=go_no_go_gate_run_mode_excluded_from_fast_gate
GO_NO_GO_EXPECTED_RUN_MODE_COMMAND_STATUS=dry_run_no_commands_executed
GO_NO_GO_EXPECTED_COMBINED_LANE_MARKER_CONTRACT_STATUS=verified
GO_NO_GO_REQUIRED_PROMOTION_EVIDENCE_REASON_MARKERS_CSV=promotion_evidence_link_missing,promotion_evidence_payload_tamper_detected,promotion_decision_reason_mapping_mismatch
GO_NO_GO_REQUIRED_PROMOTION_DECISION_REASON_MARKERS_CSV=release_manifest_missing_required_artifact,gate_required_artifact_status_mismatch,runtime_budget_exceeded

CI_TOOLS_FAST_MODE_REQUIRED_ENTRY=cargo test -p kamn-core --test lifecycle_ci_dry_run_governance_contract -- --nocapture
CI_TOOLS_FAST_MODE_FORBIDDEN_ENTRY=bash "$ROOT_DIR/scripts/runtime/run_go_no_go_gate_lane.sh" --mode run
CI_FAST_GATE_WORKFLOW_FORBIDDEN_ENTRY=bash scripts/runtime/run_go_no_go_gate_lane.sh --mode run
