# Enforced thresholds for first-wave Rust test file size governance.
schema_version=kamn.ci.test-file-size-policy-thresholds.v1
reason_taxonomy_version=kamn.ci.test-file-size-policy-reason-taxonomy.v1
reason_codes_csv=threshold_file_missing,threshold_file_invalid,baseline_file_missing,baseline_file_invalid,test_file_severe_threshold_exceeded,test_file_hard_threshold_exceeded,severe_allowlist_drift,soft_warn_count_budget_exceeded,severe_count_budget_exceeded,hard_count_budget_exceeded,test_file_inventory_drift
soft_warn_lines=500
severe_refactor_lines=2000
hard_fail_lines=3200
max_soft_warn_count=37
max_severe_count=2
max_hard_fail_count=0
