# Fast-gate runtime/cost baseline and allowed regression envelope.
# Keep these values conservative to catch meaningful regressions while avoiding noise.

FAST_GATE_DELTA_BASELINE_ELAPSED_SECONDS=230
FAST_GATE_DELTA_BASELINE_RUNNER_MINUTES=4

# Allowed positive variance from baseline before a waiver is required.
FAST_GATE_DELTA_MAX_ELAPSED_DELTA_PCT=60
FAST_GATE_DELTA_MAX_RUNNER_MINUTES_DELTA_PCT=60

# Fail closed if threshold metadata is stale.
FAST_GATE_DELTA_THRESHOLD_REFRESHED_ON=2026-02-14
FAST_GATE_DELTA_THRESHOLD_MAX_AGE_DAYS=3650
