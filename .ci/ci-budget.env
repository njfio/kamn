# Stage-1 CI budget thresholds
# Fast gate: PR-required lane
FAST_GATE_MAX_SECONDS=900
FAST_GATE_WARN_PERCENT=90
FAST_GATE_MAX_RUNNER_MINUTES=25
FAST_GATE_MAX_JOB_COUNT=1

# Deep validation: nightly/manual lane
DEEP_VALIDATE_MAX_SECONDS=7200
DEEP_VALIDATE_WARN_PERCENT=90
DEEP_VALIDATE_MAX_RUNNER_MINUTES=120
DEEP_VALIDATE_MAX_JOB_COUNT=1
